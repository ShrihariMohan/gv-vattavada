# Copy to .env.local (never commit secrets).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# When true, unused on the client (the staff app always talks to /api/sync).
# Keep true so server-side tools know cloud ingest is intended.
NEXT_PUBLIC_SYNC_ENABLED=true

# Public site origin for canonical URLs, Open Graph, sitemap.xml, and robots.txt.
# Example: https://www.your-domain.com
NEXT_PUBLIC_SITE_URL=

# Shared secret for admin-only routes (migration controls, reports, monthly archive).
# At least 16 random characters. Enter it once in Settings on the admin device.
SYNC_ADMIN_TOKEN=

# Emergency rollback switch: when "true" the server ignores feature_flags and behaves exactly
# like the pre-migration app (legacy sync_records only).
SYNC_FORCE_LEGACY=false
